## setup a pattern
M120
y0
x0 [ v0 n&0 l1 ]
x1 [ v0 l0 ]
## setup voices
v0 a0 w15 t .01 .075 .75 .25
v0 > 1 G1 H1 v1 w18 N-12,10
## put a note sequence into a stream
k! [
A:!4
B:A+50
C:B,69,33,80,45
]
k>d
/SS 0
## setup macros
[_MCA] : y0 z1 ;
[_MCB] : y0 z0 v0 l0 ;
## now alt-a starts and alt-b stops
v0n45l1~.125l0
##
z1
